@page
@using PRN221_GroupProject.Enums
@model PRN221_GroupProject.Pages.Customer.Order.DetailsModel
@{
    ViewData["Title"] = "Order Details";
    var format = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    @* Bootstrap *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/PRN221_GroupProject.styles.css" asp-append-version="true" />
    <title>Details</title>
</head>

<body>

    <div class="container py-5">
        <div class="row d-flex">
            <div class="mb-3">
                <a asp-page="/customer/order/index" class="text-decoration-none text-dark d-flex">
                    <div class="pe-1"><i class="fa-solid fa-chevron-left"></i></div>Back to List
                </a>
            </div>

            <div class="col-md-6">
                @foreach (var orderDetail in Model.OrderHeader.OrderDetails)
                {
                    var product = Model.Products.FirstOrDefault(p => p.ProductId == orderDetail.ProductId);
                    <div class="row cart-item" data-id="@orderDetail.OrderDetailId">
                        <div class="col-lg-3 col-md-12 mb-4 mb-lg-0">
                            <div class="bg-image hover-overlay hover-zoom ripple rounded" data-mdb-ripple-color="light">
                                <img src="data:image /png;base64, @product.ImageUrl" class="w-100" />
                                <a href="#!">
                                    <div class="mask" style="background-color: rgba(251, 251, 251, 0.2)"></div>
                                </a>
                            </div>
                        </div>

                        <div class="col-lg-5 col-md-6 mb-4 mb-lg-0">
                            <p><strong class="fs-5">@product.Name</strong></p>
                            <p class="me-1">Color: @orderDetail.Color</p>
                        </div>

                        <div class="col-lg-4 col-md-6 mb-4 ps-3 mb-lg-0">
                            <div class="mb-3 d-flex justify-content-lg-start">
                                <span class="text-muted me-2">Quanity:</span>
                                <strong class="text-md-center">@orderDetail.Count</strong>
                            </div>
                            <div class="mb-3 d-flex justify-content-lg-start">
                                <span class="text-muted me-2">Unit Price:</span>
                                <strong class="text-md-center unit-price" data-price="@product.Price">@String.Format(format, "{0:c0}", product.Price)</strong>
                            </div>
                            <div class="mb-3 d-flex justify-content-lg-start">
                                <span class="text-muted me-2">Amount:</span>
                                <strong class="text-md-center amount">@String.Format(format, "{0:c0}", product.Price * orderDetail.Count)</strong>
                            </div>
                        </div>
                    </div>
                    <hr class="my-4" />
                }
            </div>
            <div class="col-md-6">
                <div class="order-header-info" style="padding-left:50px;">
                    <div class="mb-2">
                        <span class="text-muted me-2">Payment Method:</span>
                        <strong class="text-md-center">@Model.OrderHeader.PaymentMethod</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted me-2">Coupon Discounts: </span>
                        <strong class="text-md-center">@* @Model.OrderHeader.Coupon.CouponCode *@</strong>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted me-2">Total Price:</span>
                        <strong class="text-md-center">@String.Format(format, "{0:c0}", Model.OrderHeader.TotalPrice)</strong>
                    </div>
                    <hr />
                </div>

                <div class="order-header-action d-flex" style="padding-left:50px;">
                    @if (Model.OrderHeader.OrderStatus.Equals(OrderStatusEnum.Shipping.ToString()))
                    {
                        <form method="post" asp-page-handler="ChangeStatus" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId">
                            <button type="submit" class="btn btn-info">
                                Package Received
                            </button>
                            <button type="submit" disabled class="btn btn-secondary">
                                Refund Order
                            </button>
                        </form>

                        <form method="post" asp-page-handler="CancelOrder" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId" onsubmit="return confirm('Are you sure to cancel this order?');">
                            <button type="submit" disabled class="btn btn-danger ms-1">
                                Cancel Order
                            </button>
                        </form>
                    }
                    else if (Model.OrderHeader.OrderStatus.Equals(OrderStatusEnum.Shipped.ToString()))
                    {
                        <form method="post" asp-page-handler="ChangeStatus" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId">
                            <button type="submit" disabled class="btn btn-info">
                                Package Received
                            </button>
                            <button type="submit" class="btn btn-secondary">
                                Refund Order
                            </button>
                        </form>

                        <form method="post" asp-page-handler="CancelOrder" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId" onsubmit="return confirm('Are you sure to cancel this order?');">
                            <button type="submit" disabled class="btn btn-danger ms-1">
                                Cancel Order
                            </button>
                        </form>
                    }
                    else if ((Model.OrderHeader.OrderStatus.Equals(OrderStatusEnum.Refunded.ToString())) ||
                    (Model.OrderHeader.OrderStatus.Equals(OrderStatusEnum.Cancelled.ToString())))
                    {
                        <form method="post" asp-page-handler="ChangeStatus" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId">
                            <button type="submit" disabled class="btn btn-info">
                                Package Received
                            </button>
                            <button type="submit" disabled class="btn btn-secondary">
                                Refund Order
                            </button>
                        </form>

                        <form method="post" asp-page-handler="CancelOrder" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId" onsubmit="return confirm('Are you sure to cancel this order?');">
                            <button type="submit" disabled class="btn btn-danger ms-1">
                                Cancel Order
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="ChangeStatus" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId">
                            <button type="submit" disabled class="btn btn-info">
                                Package Received
                            </button>
                            <button type="submit" disabled class="btn btn-secondary">
                                Refund Order
                            </button>
                        </form>

                        <form method="post" asp-page-handler="CancelOrder" asp-route-orderHeaderId="@Model.OrderHeader.OrderHeaderId" onsubmit="return confirm('Are you sure to cancel this order?');">
                            <button type="submit" class="btn btn-danger ms-1">
                                Cancel Order
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>



    </div>

</body>
</html>
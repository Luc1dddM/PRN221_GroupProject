@page
@model PRN221_GroupProject.Pages.CustomerProducts.DetailsModel

@{
    ViewData["Title"] = "Details";
    var format = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<head>
    <meta charset="UTF-8">
</head>

<body>
    <div class="container p-5">
        <div class="row">
            <div class="mb-3 ">
                <a asp-page="./index" class="text-decoration-none text-dark d-flex">
                    <div class="pe-1"><i class="fa-solid fa-chevron-left"></i></div>Back to List
                </a>
            </div>
            @* image section start*@
            <div class="col-md-6">
                <div class="border rounded-4 mb-3 d-flex justify-content-center">
                    <a data-fslightbox="mygalley" class="rounded-4" target="_blank" data-type="image" href="">
                        <img style="max-width: 100%; max-height: 100vh; margin: auto;" class="rounded-4 fit" src="data:image /png;base64, @Model.Product.ImageUrl" />
                    </a>
                </div>
            </div>
            @* image section end*@
            <main class="col-md-6">
                <div class="ps-lg-3">
                    <h4 class="title text-dark">
                        @Model.Product.Name
                    </h4>
                    <div class="d-flex flex-row my-3">
                        <span class="text-muted"><i class="fas fa-shopping-basket fa-sm"></i></span>
                        @* thís line for display the quantity for a color of a product *@
                        <span class="ms-2" id="stock-quantity"></span> 
                    </div>

                    <div class="mb-3">
                        <span class="h3">@String.Format(format, "{0:c0}", Model.Product.Price)</span>
                    </div>

                    <div class="">
                        <p>
                            @Model.Product.Description
                        </p>
                    </div>

                    <hr />
                    <form method="post">
                        <div class="row mb-4">
                            <div class="col-md-4 col-6">
                                <label class="mb-2">Color</label>
                                <select asp-for=CartDetail.Color id="color-select" class="form-select border border-secondary" style="height: 35px;" onchange="updateStockQuantity()">
                                    @foreach (var color in Model.ProductColors)
                                    {
                                        <option value="@color">@color</option>
                                    }
                                </select>
                                @* <input asp-for="CartDetail.Color" type="hidden" id="selected-color"/> *@
                            </div>

                            <div class="col-md-4 col-6 mb-3">
                                <label class="mb-2 d-block">Quantity</label>
                                <div class="input-group mb-3" style="width: 170px;">
                                    <button class="btn btn-white border border-secondary px-3" type="button" id="button-minus" data-mdb-ripple-color="dark">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input asp-for="CartDetail.Count" type="text" id="quantity-input" class="form-control text-center border border-secondary" placeholder="1" value="1" />
                                    <button class="btn btn-white border border-secondary px-3" type="button" id="button-plus" data-mdb-ripple-color="dark">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <button type="submit" id="add-to-cart-button" class="btn btn-primary">
                            <input asp-for="CartDetail.ProductId" type="hidden" value="@Model.Product.ProductId" />
                            <i class="me-1 fa fa-shopping-basket"></i> Add to cart
                        </button>
                    </form>
                </div>
            </main>
        </div>
    </div>
</body>


<script>
    document.getElementById('button-minus').addEventListener('click', function () {
        var quantityInput = document.getElementById('quantity-input');
        var currentValue = parseInt(quantityInput.value);
        if (currentValue > 1) {
            quantityInput.value = currentValue - 1;
            document.getElementById('button-plus').disabled = false;
        }
    });

    document.getElementById('button-plus').addEventListener('click', function () {
        var quantityInput = document.getElementById('quantity-input');
        var currentValue = parseInt(quantityInput.value);
        // productColorQuantity[document.getElementById('color-select').value] is define in the script below
        const maxQuantity = productColorQuantity[document.getElementById('color-select').value];
        if (currentValue < maxQuantity) {
            quantityInput.value = currentValue + 1;
        }
        if (parseInt(quantityInput.value) >= maxQuantity) {
            document.getElementById('button-plus').disabled = true;
        }
    });

    document.getElementById('quantity-input').addEventListener('input', function (e) {
        var quantityInput = e.target;
        var value = quantityInput.value;
        const maxQuantity = productColorQuantity[document.getElementById('color-select').value];

        // Ensure the value is a positive number and does not exceed the max quantity
        if (!/^\d+$/.test(value) || parseInt(value) < 1) {
            quantityInput.value = value.replace(/\D/g, '');
            if (quantityInput.value === '' || parseInt(quantityInput.value) < 1) {
                quantityInput.value = 1;
            }
        }

        if (parseInt(value) > maxQuantity) {
            quantityInput.value = maxQuantity;
        }

        // Disable the plus button if the max quantity is reached
        if (parseInt(quantityInput.value) >= maxQuantity) {
            document.getElementById('button-plus').disabled = true;
        } else {
            document.getElementById('button-plus').disabled = false;
        }
    });

</script>

@* this section of script is using to display the quanity of eahc color of the product *@
@section Scripts {
    <script>
        const productColorQuantity = @Html.Raw(Json.Serialize(Model.ProductColorQuantity));

        function updateStockQuantity() {
            const colorSelect = document.getElementById('color-select');
            const selectedColor = colorSelect.value;
            const stockQuantity = document.getElementById('stock-quantity');
            const quantityInput = document.getElementById('quantity-input');
            const addToCartButton = document.getElementById('add-to-cart-button');
            const buttonMinus = document.getElementById('button-minus');
            const buttonPlus = document.getElementById('button-plus');

            const quantity = productColorQuantity[selectedColor];

            if (quantity <= 0) {
                quantityInput.disabled = true;
                addToCartButton.disabled = true;
                buttonMinus.disabled = true;
                buttonPlus.disabled = true;
                stockQuantity.innerText = 'Out of stock';
                stockQuantity.classList.remove('text-success');
                stockQuantity.classList.add('text-danger');
            } else {
                quantityInput.disabled = false;
                addToCartButton.disabled = false;
                buttonMinus.disabled = false;
                buttonPlus.disabled = false;
                stockQuantity.innerText = quantity + ' In stock';
                stockQuantity.classList.remove('text-danger');
                stockQuantity.classList.add('text-success');
            }   
        }

        // Initialize the stock quantity display on page load
        document.addEventListener('DOMContentLoaded', (event) => {
            updateStockQuantity();
        });
    </script>
}


























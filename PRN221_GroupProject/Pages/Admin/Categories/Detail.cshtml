@page
@model PRN221_GroupProject.Pages.Categories.DetailModel

@{
    ViewData["Title"] = "Edit";
    Layout = null;
}




<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit Category</title>
    @* Bootstrap *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />

    <link rel="stylesheet" href="~/PRN221_GroupProject.styles.css" asp-append-version="true" />

    @* font awesome *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>

<body>
    <div class="themesbackground">
        <div class="container themesform">
            <div class="p-4 mb-2 bg-white text-dark rounded">
                <div class="pl-5 pr-5 pt-2 text-center d-flex justify-content-between">
                    <div class="pt-1">
                        <a asp-page="Index"><i class="fa-solid fa-chevron-left"></i></a>
                    </div>
                    <h3>Edit Category</h3>
                    <div></div>
                </div>
                <div class="p-4">
                    <div>
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Category.CategoryId" />
                            <input type="hidden" asp-for="Category.Id" />
                           <div class="row">
                               <div class="col-md-6">
                                    <div class="form-group py-2">
                                        <label asp-for="Category.Name" class="control-label pb-2"></label>
                                        <input asp-for="Category.Name" class="form-control" />
                                        <span asp-validation-for="Category.Name" class="text-danger"></span>
                                    </div>
                                    <div class="form-group py-2">

                                        <label asp-for="Category.Type" class="control-label pb-2"></label>
                                        <select asp-for="Category.Type" class="form-control">
                                            <option value="Brand">Brand</option>
                                            <option value="Device">Device</option>
                                            <option value="Color">Color</option>
                                        </select>
                                        <span asp-validation-for="Category.Type" class="text-danger"></span>
                                    </div>
                                    <div class="form-group py-2">
                                        <div class="pe-3 pt-1">
                                            <label class="control-label">Status</label>
                                        </div>
                                        <div class="form-group form-check form-switch mt-2 mb-1">
                                            <input class="form-check-input" asp-for="Category.Status" />
                                        </div>
                                    </div>
                               </div>
                               <div class="col-md-6">
                                    <div class="form-group py-2">
                                        <label asp-for="Category.CreatedAt" class="control-label pb-2"></label>
                                        <input readonly asp-for="Category.CreatedAt" class="form-control" />
                                        <span asp-validation-for="Category.CreatedAt" class="text-danger"></span>
                                    </div>

                                    <div class="form-group py-2">
                                        <label asp-for="Category.CreatedBy" class="control-label pb-2"></label>
                                        <input readonly asp-for="Category.CreatedBy" class="form-control" />
                                        <span asp-validation-for="Category.CreatedBy" class="text-danger"></span>
                                    </div>
                                    <div class="form-group py-2">
                                        <label asp-for="Category.UpdatedAt" class="control-label pb-2"></label>
                                        <input readonly asp-for="Category.UpdatedAt" class="form-control" />
                                        <span asp-validation-for="Category.UpdatedAt" class="text-danger"></span>
                                    </div>
                                    <div class="form-group py-2">
                                        <label asp-for="Category.UpdatedBy" class="control-label pb-2"></label>
                                        <input readonly asp-for="Category.UpdatedBy" class="form-control" />
                                        <span asp-validation-for="Category.UpdatedBy" class="text-danger"></span>
                                    </div>
                               </div>
                           </div>
                           

                            <div class="d-flex justify-content-center pt-3">
                                <input type="submit" value="Save" class="btn btn-primary" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>

</html>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<div style="background-color: #CDC4F9;">
    <div class="container py-5">

        <div class="row">
            <div class="col-md-12">

                <div class="card" id="chat-section" style="border-radius: 15px;">
                    <div class="card-body">

                        <div class="row">
                            <div class="col-md-3 mb-4 mb-md-0 border-end">

                                <div class="p-1">

                                    <div data-mdb-perfect-scrollbar-init style="position: relative; height: 400px">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var user in Model.Users)
                                            {
                                                <li class="p-2 border-bottom">
                                                    <a href="?id=@user.Id" class="d-flex justify-content-between text-decoration-none">
                                                        <div class="d-flex flex-row">
                                                            <div>
                                                                <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava2-bg.webp"
                                                                     alt="avatar" class="d-flex align-self-center me-3" width="60">
                                                                <span class="badge bg-warning badge-dot"></span>
                                                            </div>
                                                            <div class="d-flex align-items-center">
                                                                <p class="fs-4 fw-bold m-0">@user.Name</p>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex align-items-center">
                                                            <span class="badge bg-danger rounded-pill float-end">3</span>
                                                        </div>
                                                    </a>
                                                </li>
                                            }

                                        </ul>
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-9">
                                @* chat content will appear here *@
                                <div id="messagesList" class="chat-body" data-mdb-perfect-scrollbar-init
                                     style="position: relative; height: 400px; overflow-y: auto; padding: 16px 16px 0 16px">

                                </div>

                                <hr class="my-1">

                                <div class="text-muted d-flex justify-content-start align-items-center p-3 mt-2">
                                    <img class="me-1" src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava6-bg.webp"
                                         alt="avatar 3" style="width: 45px; height: 100%;">

                                    <form method="post" class="w-100 d-flex">
                                        <input type="hidden" value="@Model.user" id="currentUser" />
                                        <input asp-for="@Model.GroupName" id="room" type="hidden" value="@Model.GroupName" />
                                        <input asp-for="@Model.message.MessageContent" type="text" id="messageInput" class="form-control form-control-lg" placeholder="Type your messages here..." />
                                        <button id="sendButton" type="submit" class="ms-1 border-0 rounded-circle btn-primary" style="width: 45px; height: 45px; display: flex; justify-content: center; align-items: center; padding: 0;">
                                            <i class="fa-solid fa-paper-plane"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/ChatboxAdminToCustomer.js"></script>
}



